# ==========================================
# 🤖 Quester Discord Bot Configuration
# ==========================================

# 1. Bot Credentials (من Discord Developer Portal)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
CLIENT_ID=YOUR_APPLICATION_CLIENT_ID_HERE

# 2. Quest Notifier Settings
# توكن حساب مستخدم عادي (User Token) عشان يسحب بيانات المهام الرسمية من Discord API:
DISCORD_USER_TOKEN=YOUR_DISCORD_USER_TOKEN_HERE

# ايدي الروم اللي هينزل فيه الإيمبد بالمهام الجديدة:
NOTIFICATION_CHANNEL_ID=1414963290391707779

# ايدي رول الإشعارات للمنشن (اختياري - اتركه فارغاً لو مش عايز منشن):
NOTIFICATION_ROLE_ID=

# 3. Links
WEBSITE_URL=https://quester-service.vercel.app/quests
SUPPORT_SERVER_URL=https://discord.gg/Yeb9bRX7Qf

# 4. Check Interval (افتراضياً: كل 5 دقائق)
CRON_INTERVAL=*/5 * * * *

